{
  "permissions": {
    "allow": [
      "Bash(node --test tests/*)",
      "Bash(npm run typecheck*)",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "Bash(npx tsc --noEmit*)",
      "mcp__visualize__read_me",
      "Bash(diff *)",
      "Bash(npm test)",
      "Bash(npm run smoke)",
      "Bash(npm run e2e)",
      "Bash(npm run studio:check*)",
      "Bash(node scripts/generate-context-docs.js*)",
      "Bash(node scripts/bump-version.js)",
      "Bash(node --check *)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/docs/studio/steering/next.md\"; [ -f \"$f\" ] && { echo \"[Shadow Studio] Where the studio team is (docs/studio/steering/next.md). \\\"studio next\\\" runs this step with the studio-iteration skill; ignore it for arcade work.\"; cat \"$f\"; }; true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
